{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CMF EQ",
  "version": "0.1.0",
  "identifier": "app.cmfeq.desktop",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "title": "CMF · EQ",
      "width": 460,
      "height": 690,
      "minWidth": 440,
      "minHeight": 660,
      "center": true,
      "decorations": false,
      "shadow": true,
      "maximizable": false,
      "backgroundColor": "#080808"
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": { "active": false, "icon": ["icons/cmf-eq.ico", "icons/cmf-eq.png"] }
}
